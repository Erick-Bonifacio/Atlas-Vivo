{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "pdx1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__p=:path*"
    },
    {
      "source": "/presentation",
      "destination": "/presentation.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{supabase-ca.crt,public/atlas2/manifest.json,questions/official/**,public/img/q/**}"
    }
  }
}
