{
  "name": "atlas-vivo",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas Vivo: atlas 3D do corpo humano com aulas, quizzes comentados e gamificação",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env.dev server.js",
    "dev:demo": "node --env-file=.env.dev --env-file=.env.demo server.js",
    "preview": "node tools/preview/server.js",
    "review": "python -I tools/ingest/review_server.py",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/*.test.js\"",
    "test:e2e": "node --env-file=.env.test test.js",
    "test:ingest": "python -m unittest discover -s tools/ingest/tests"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
